# Root allowlist: local media and generated directories stay private by default.
/*
!/.gitignore
!/README.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/pyproject.toml
!/requirements-lock.txt
!/tools-manifest.json
!/.github/
!/wallpaper_studio/
!/scripts/
!/tests/
!/docs/
!/licenses/
.venv/
__pycache__/
.pytest_cache/
*.egg-info/
build/
dist/
artifacts/
test-workspace/
tools/*.exe
tools/*.zip
*.spec
.superpowers/

private/
samples/local/
.env
.env.*
*.pem
*.key
